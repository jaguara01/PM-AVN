# Copy to .env.local. Everything is optional for local development:
# with nothing set, the app uses an embedded database and offline profile extraction.

# Postgres with the pgvector extension. Leave empty to use the embedded database in .data/
DATABASE_URL=

# Claude writes project profiles (summary, keywords, technologies). Leave empty for the offline extractor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Embeddings: any service with an OpenAI-style POST {base}/embeddings endpoint.
# Leave EMBEDDINGS_BASE_URL empty for the local word-hashing fallback (matches wording, not meaning).
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
