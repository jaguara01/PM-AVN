# Copy to .env.local. Everything is optional for local development:
# with nothing set, the app uses an embedded database and offline profile extraction.

# Postgres with the pgvector extension. Leave empty to use the embedded database in .data/
DATABASE_URL=

# ---- Text model: writes project profiles (summary, keywords, technologies). Pick ONE option. ----

# Option A: Claude, with a key from console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Option B: any OpenAI-compatible chat API. Wins over option A when both are set.
#   Azure OpenAI:  LLM_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1
#                  LLM_MODEL=<your deployment name, e.g. gpt-4.1-mini>
#                  LLM_API_KEY=<KEY 1 from the resource's Keys and Endpoint page>
#   Google Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                  LLM_MODEL=gemini-3.8-flash
#                  LLM_API_KEY=<key from aistudio.google.com>
#   Ollama (local, free):  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2  (no key)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ---- Embeddings: any OpenAI-style /embeddings endpoint. ----
#   Azure OpenAI:  same base URL and key as above, EMBEDDINGS_MODEL=<embedding deployment name, e.g. text-embedding-3-small>
#   Google Gemini: same base URL and key as above, EMBEDDINGS_MODEL=gemini-embedding-2
#   Ollama:        EMBEDDINGS_BASE_URL=http://localhost:11434/v1  EMBEDDINGS_MODEL=nomic-embed-text
# Leave EMBEDDINGS_BASE_URL empty for the local word-hashing fallback (matches wording, not meaning).
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
